{
  "name": "@ramen-ai/mcp-shield-proxy",
  "version": "0.1.4",
  "description": "Universal MCP stdio proxy that intercepts tools/call JSON-RPC messages and evaluates them against the ramen-ai L2 Semantic Firewall before forwarding to the downstream MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-shield-proxy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "RED_TEAM_GUIDE.md",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ramen-ai-dev/mcp-shield-proxy"
  },
  "bugs": {
    "url": "https://github.com/ramen-ai-dev/mcp-shield-proxy/issues"
  },
  "homepage": "https://github.com/ramen-ai-dev/mcp-shield-proxy#readme",
  "dependencies": {
    "@ramen-ai/node-core": "0.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild": "0.25.5"
  }
}
